# InboxKey Environment Variables
# Copy this file to .env and fill in your values.

# Gmail OAuth Client ID (required for Gmail connection)
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create or select a project
# 2. Enable Gmail API
# 3. Create OAuth 2.0 Client ID (type: Chrome extension)
PLASMO_PUBLIC_GMAIL_CLIENT_ID=YOUR_GMAIL_CLIENT_ID.apps.googleusercontent.com

# Development (optional)
# NODE_ENV=development
# PLASMO_DEV_PORT=1012
# PLASMO_HMR_PORT=1815
