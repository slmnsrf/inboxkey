# InboxKey Environment Variables
# Copy this file to .env and fill in your OAuth credentials

# ============================================
# OAuth Credentials (REQUIRED for connection buttons)
# ============================================

# Gmail OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing
# 2. Enable Gmail API
# 3. Create OAuth 2.0 Client ID (Chrome extension)
# 4. Authorised redirect URI (auto-generated):
#    https://[YOUR-EXTENSION-ID].chromiumapp.org/
PLASMO_PUBLIC_GMAIL_CLIENT_ID=YOUR_GMAIL_CLIENT_ID.apps.googleusercontent.com

# Outlook/Microsoft OAuth Client ID
# Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# 1. Register new application
# 2. Add redirect URI: https://[YOUR-EXTENSION-ID].chromiumapp.org/
# 3. Add API permissions: Mail.Read, offline_access
PLASMO_PUBLIC_OUTLOOK_CLIENT_ID=YOUR_OUTLOOK_CLIENT_ID

# ============================================
# Git Identity (used in containers)
# ============================================
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your@email.com
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=your@email.com

# ============================================
# Development (Optional)
# ============================================
# NODE_ENV=development
# PLASMO_DEV_PORT=1012
# PLASMO_HMR_PORT=1815

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace YOUR_GMAIL_CLIENT_ID with your actual Gmail OAuth client ID
# 3. Replace YOUR_OUTLOOK_CLIENT_ID with your actual Outlook OAuth client ID
# 4. After adding credentials, run: npm run build
# 5. Test the connection buttons in the extension
#
# IMPORTANT: Keep .env file secure and never commit it to git!
